/* Machine intro patch
 * Original HUD-style opening overlay for the-machine-log.
 * It uses abstract surveillance UI motifs without copying any show assets.
 */

:root
  --machine-intro-bg #05070A
  --machine-intro-panel rgba(13, 17, 23, .78)
  --machine-intro-line rgba(57, 255, 136, .42)
  --machine-intro-blue rgba(88, 166, 255, .72)
  --machine-intro-text #D7E0EA
  --machine-intro-muted #7D8590

.machine-intro
  position fixed
  inset 0
  z-index 9999
  display grid
  place-items center
  min-height 100vh
  overflow hidden
  color var(--machine-intro-text)
  background var(--machine-intro-bg)
  opacity 1
  visibility visible
  transition opacity .7s ease, visibility .7s ease
  font-family "JetBrains Mono", "Fira Code", "SFMono-Regular", Consolas, monospace

  &.is-hidden
    opacity 0
    visibility hidden
    pointer-events none

  &.is-dismissed
    display none

.machine-intro__background
  position absolute
  inset 0
  background:
    radial-gradient(circle at 22% 18%, rgba(31, 111, 235, .18), transparent 32%),
    radial-gradient(circle at 76% 72%, rgba(57, 255, 136, .12), transparent 36%),
    #05070A

.machine-intro__grid
  position absolute
  inset 0
  opacity .58
  background-image:
    url("/images/machine-bg-grid.svg"),
    linear-gradient(rgba(57, 255, 136, .04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(88, 166, 255, .035) 1px, transparent 1px)
  background-size cover, 48px 48px, 48px 48px
  background-position center
  transform scale(1.04)

.machine-intro__noise
  position absolute
  inset -20%
  opacity .24
  background-image url("/images/machine-bg-noise.svg")
  background-size 320px 320px
  animation machineNoise 1.6s steps(2, end) infinite

.machine-intro__scan
  position absolute
  inset 0
  background:
    linear-gradient(to bottom, transparent, rgba(57, 255, 136, .13), transparent),
    repeating-linear-gradient(to bottom, rgba(255,255,255,.025), rgba(255,255,255,.025) 1px, transparent 1px, transparent 5px)
  mix-blend-mode screen
  transform translateY(-100%)
  animation machineScan 3.2s ease-in-out infinite

.machine-intro__locator
  position absolute
  border 1px solid rgba(57, 255, 136, .34)
  box-shadow 0 0 22px rgba(57, 255, 136, .08), inset 0 0 18px rgba(57, 255, 136, .04)
  background rgba(57, 255, 136, .025)
  animation machinePulse 2.8s ease-in-out infinite

  &::before,
  &::after
    content ""
    position absolute
    width 18px
    height 18px
    border-color rgba(57, 255, 136, .78)
    border-style solid

  &::before
    top -1px
    left -1px
    border-width 2px 0 0 2px

  &::after
    right -1px
    bottom -1px
    border-width 0 2px 2px 0

.machine-intro__locator--a
  width min(26vw, 320px)
  height min(18vw, 190px)
  left 7vw
  top 18vh

.machine-intro__locator--b
  width min(22vw, 260px)
  height min(14vw, 150px)
  right 9vw
  top 24vh
  animation-delay .35s

.machine-intro__locator--c
  width min(30vw, 380px)
  height min(16vw, 180px)
  right 20vw
  bottom 13vh
  animation-delay .75s

.machine-intro__panel
  position relative
  width min(760px, calc(100vw - 32px))
  padding clamp(24px, 4vw, 44px)
  border 1px solid rgba(88, 166, 255, .32)
  background linear-gradient(180deg, rgba(13, 17, 23, .86), rgba(8, 11, 16, .74))
  box-shadow 0 24px 80px rgba(0, 0, 0, .52), inset 0 0 60px rgba(57, 255, 136, .035)
  backdrop-filter blur(14px)
  transform translateY(10px) scale(.985)
  animation machinePanelIn .72s ease forwards

.machine-intro__corner
  position absolute
  width 34px
  height 34px
  pointer-events none
  border-color rgba(57, 255, 136, .75)
  border-style solid

.machine-intro__corner--tl
  top -1px
  left -1px
  border-width 2px 0 0 2px

.machine-intro__corner--tr
  top -1px
  right -1px
  border-width 2px 2px 0 0

.machine-intro__corner--bl
  bottom -1px
  left -1px
  border-width 0 0 2px 2px

.machine-intro__corner--br
  right -1px
  bottom -1px
  border-width 0 2px 2px 0

.machine-intro__meta
  display flex
  flex-wrap wrap
  gap 10px 18px
  justify-content space-between
  margin-bottom 30px
  color var(--machine-intro-muted)
  font-size 12px
  letter-spacing .12em
  text-transform uppercase

  span:first-child
    color #39FF88
    text-shadow 0 0 14px rgba(57, 255, 136, .36)

.machine-intro__title
  display grid
  gap 10px
  margin-bottom 26px

  strong
    color #D7E0EA
    font-size clamp(38px, 7vw, 74px)
    line-height .94
    letter-spacing .08em
    text-transform uppercase
    text-shadow 0 0 30px rgba(88, 166, 255, .24)

.machine-intro__eyebrow
  color #58A6FF
  font-size 13px
  letter-spacing .32em

.machine-intro__terminal
  display grid
  gap 8px
  min-height 150px
  padding 18px
  border 1px solid rgba(57, 255, 136, .18)
  background rgba(5, 7, 10, .58)

  p
    margin 0
    color rgba(215, 224, 234, .88)
    opacity 0
    transform translateY(6px)
    font-size clamp(13px, 2vw, 15px)
    line-height 1.55

  p.is-visible
    opacity 1
    transform translateY(0)
    transition opacity .32s ease, transform .32s ease

.machine-intro__progress
  height 3px
  margin-top 24px
  overflow hidden
  background rgba(125, 133, 144, .18)

  span
    display block
    width 0
    height 100%
    background linear-gradient(90deg, #1F6FEB, #39FF88)
    box-shadow 0 0 16px rgba(57, 255, 136, .52)
    animation machineProgress 3.4s ease forwards

.machine-intro__skip
  position absolute
  right 18px
  bottom 16px
  border 1px solid rgba(125, 133, 144, .42)
  padding 6px 10px
  color rgba(215, 224, 234, .76)
  background rgba(5, 7, 10, .62)
  font inherit
  font-size 11px
  letter-spacing .16em
  cursor pointer
  transition border-color .2s ease, color .2s ease, background .2s ease

  &:hover,
  &:focus-visible
    border-color rgba(57, 255, 136, .72)
    color #39FF88
    background rgba(57, 255, 136, .08)
    outline none

@keyframes machinePanelIn
  to
    transform translateY(0) scale(1)

@keyframes machineScan
  0%
    transform translateY(-100%)
  54%
    transform translateY(100%)
  100%
    transform translateY(100%)

@keyframes machinePulse
  0%, 100%
    opacity .35
    transform scale(1)
  50%
    opacity .82
    transform scale(1.015)

@keyframes machineNoise
  0%, 100%
    transform translate(0, 0)
  50%
    transform translate(-2%, 1.5%)

@keyframes machineProgress
  0%
    width 0
  68%
    width 82%
  100%
    width 100%

@media (prefers-reduced-motion: reduce)
  .machine-intro,
  .machine-intro *
    animation none !important
    transition none !important

  .machine-intro__terminal p
    opacity 1
    transform none

@media (max-width: 640px)
  .machine-intro__locator
    display none

  .machine-intro__panel
    padding 24px 18px 54px

  .machine-intro__meta
    justify-content flex-start

  .machine-intro__terminal
    min-height 128px
