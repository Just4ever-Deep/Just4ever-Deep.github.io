<%
  const oneDay = 24 * 60 * 60 * 1000;
  const now = new Date();
  const end = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const start = new Date(end.getTime() - 364 * oneDay);
  const dayMap = {};
  site.posts.forEach(function(post) {
    const d = new Date(post.date);
    const key = date(d, 'YYYY-MM-DD');
    dayMap[key] = (dayMap[key] || 0) + 1;
  });
  const cells = [];
  const monthMarks = [];
  for (let i = 0; i < 365; i += 1) {
    const d = new Date(start.getTime() + i * oneDay);
    const key = date(d, 'YYYY-MM-DD');
    const count = dayMap[key] || 0;
    const level = count === 0 ? 0 : count < 2 ? 1 : count < 4 ? 2 : count < 6 ? 3 : 4;
    const week = Math.floor(i / 7);
    if (d.getDate() === 1) {
      monthMarks.push({ name: date(d, 'MMM'), left: week * 15 });
    }
    cells.push({ key, count, level });
  }
%>
<section class="calendar-page hud-box">
  <div class="calendar-head">
    <h1><%= __('calendar.title') %></h1>
    <p class="calendar-sub"><%= __('calendar.subtitle') %></p>
  </div>

  <div class="calendar-grid-wrap">
    <div class="calendar-months">
      <% monthMarks.forEach(function(mark){ %>
        <span style="left:<%= mark.left %>px"><%= mark.name %></span>
      <% }) %>
    </div>
    <div class="calendar-grid" aria-label="<%= __('calendar.aria') %>">
      <% cells.forEach(function(cell){ -%>
        <div class="calendar-cell calendar-level-<%= cell.level %>" title="<%= cell.key %> · <%= cell.count %> <%= __('calendar.posts_unit') %>"></div>
<% }) -%>
    </div>
  </div>

  <div class="calendar-meta">
    <span><%= __('calendar.range') %>: <%= date(start, 'YYYY-MM-DD') %> ~ <%= date(end, 'YYYY-MM-DD') %></span>
    <span class="calendar-legend">
      <%= __('calendar.less') %>
      <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i>
      <%= __('calendar.more') %>
    </span>
  </div>
</section>
